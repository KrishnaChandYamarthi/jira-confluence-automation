# Local development only. Replace these placeholders in a private root .env file.
POSTGRES_DB=jira_automation
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Explicit opt-in for a local-only demo; never enable outside development.
MOCK_AUTH_ENABLED=false
MOCK_AUTH_ORIGIN=http://127.0.0.1:5173
